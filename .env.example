# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash. Used for canonical links and link previews.
SITE_URL=https://yourdomain.com

# Admin account. The password is only read on the very first start, to create the account.
# After that, change it from the Settings page in /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional. If empty, a random secret is generated once and stored in the data volume.
JWT_SECRET=
